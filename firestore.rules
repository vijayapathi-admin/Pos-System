rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.role == role) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role)
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.matches('.*admin.*') ||
        hasRole('admin') ||
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) // fallback default admin
      );
    }

    function isManager() {
      return isAdmin() || hasRole('manager');
    }

    function isCashier() {
      return isAuthenticated();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create, delete: if isManager();
      allow update: if isAuthenticated(); // Cashier updates stock, Manager updates details
    }

    // Sales Collection
    match /sales/{saleId} {
      allow read: if isAuthenticated();
      allow create: if isCashier();
      allow update: if isManager();
      allow delete: if isAdmin();
    }

    // Stock Movements (Immutable History)
    match /stockMovements/{movementId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Stock movements are strictly immutable
    }

    // Audit Logs (Immutable History)
    match /auditLogs/{logId} {
      allow read: if isManager();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Audit logs can NEVER be altered or deleted
    }

    // Returns Collection
    match /returns/{returnId} {
      allow read: if isAuthenticated();
      allow create, update: if isManager();
      allow delete: if isAdmin();
    }

    // Purchases Collection
    match /purchases/{purchaseId} {
      allow read: if isAuthenticated();
      allow create, update: if isManager();
      allow delete: if isAdmin();
    }

    // Daily Reports Aggregates
    match /dailyReports/{reportId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Scanner Sessions (Phone OCR Pairing)
    match /scannerSessions/{sessionId} {
      allow read, write: if true; // Public phone camera access by sessionId token
    }

    // Other operational collections
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }

  }
}

